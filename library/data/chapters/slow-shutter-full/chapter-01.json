{
  "id": "chapter-01",
  "title": "第一章｜关于速度",
  "source": {
    "file": "从慢门摄影到生活哲学  (Book).epub",
    "format": "epub",
    "label": "正文与图片依据作者确认的 EPUB 版本收录。",
    "sha256": "da12ef30d19c07a0464e179657ee3cacbbb5bc362d24af4e61937bfec821a045",

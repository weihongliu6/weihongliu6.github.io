{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shadow Library publication metadata V1",
  "type": "object",
  "required": [
    "publisher",
    "imprint",
    "edition",
    "format",
    "language",
    "isbn",
    "rights",
    "metadataVersion",
    "contributors",
    "externalEditions"
  ],
  "properties": {
    "publisher": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "imprint": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "edition": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "format": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "isbn": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^97[89][0-9]{10}$"
    },
    "rights": {
      "type": "object",
      "required": [
        "holder",
        "license",
        "statement",
        "platformPermission",
        "exclusive"
      ],
      "properties": {
        "holder": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "license": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "statement": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "platformPermission": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "exclusive": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "metadataVersion": {
      "const": 1
    },
    "contributors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "role"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "externalEditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label"
        ],
        "properties": {
          "publisher": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "imprint": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "edition": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "format": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "language": {
            "type": "string",
            "minLength": 2
          },
          "isbn": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^97[89][0-9]{10}$"
          },
          "rights": {
            "type": "object",
            "required": [
              "holder",
              "license",
              "statement",
              "platformPermission",
              "exclusive"
            ],
            "properties": {
              "holder": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "license": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "statement": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "platformPermission": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "exclusive": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          },
          "channel": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri",
            "pattern": "^https?://"
          }
        }
      }
    }
  }
}
